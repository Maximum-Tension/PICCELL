#define WEBVIEW_JS_INVOKE_ID 0x1000
#define WEBVIEW_JS_DOWNLEVEL_ID 0x1001 /* the devtools console translates */
#define WEBVIEW_JS_LOG_ID 0x1002       /* page errors to the app's log */
static HRESULT STDMETHODCALLTYPE WV_JS_GetIDsOfNames(IDispatch FAR *This,
                                                  REFIID riid,
                                                  LPOLESTR *rgszNames,
                                                  UINT cNames, LCID lcid,
                                                  DISPID *rgDispId) {
  if (cNames != 1) {
    return S_FALSE;
  }
  if (wcscmp(rgszNames[0], L"invoke") == 0) {
    rgDispId[0] = WEBVIEW_JS_INVOKE_ID;
    return S_OK;
  }
  if (wcscmp(rgszNames[0], L"downlevel") == 0) {
    rgDispId[0] = WEBVIEW_JS_DOWNLEVEL_ID;
    return S_OK;
  }
  if (wcscmp(rgszNames[0], L"log") == 0) {
    rgDispId[0] = WEBVIEW_JS_LOG_ID;
    return S_OK;
  }
  return S_FALSE;
}

static HRESULT STDMETHODCALLTYPE
WV_JS_Invoke(IDispatch FAR *This, DISPID dispIdMember, REFIID riid, LCID lcid,
          WORD wFlags, DISPPARAMS *pDispParams, VARIANT *pVarResult,
          EXCEPINFO *pExcepInfo, UINT *puArgErr) {
  size_t offset = (size_t) & ((_IOleClientSiteEx *)NULL)->external;
  _IOleClientSiteEx *ex = (_IOleClientSiteEx *)((char *)(This)-offset);
  struct webview *w = (struct webview *)GetWindowLongPtr(
      ex->inplace.frame.window, GWLP_USERDATA);
  if (pDispParams->cArgs == 1 && pDispParams->rgvarg[0].vt == VT_BSTR) {
    BSTR bstr = pDispParams->rgvarg[0].bstrVal;
    char *s = webview_from_utf16(bstr);
    if (s != NULL) {
      if (dispIdMember == WEBVIEW_JS_INVOKE_ID) {
        if (strcmp(s, "__wvready") == 0) {
          /* IE has no init-script hook: a page that wants its bound functions
             calls window.external.invoke("__wvready") once it has loaded, and
             gets them (with the window.webview bus) right here. */
          webview_install_bindings(w);
          webview_apply_page_options(w);
        } else if (webview_dispatch_binding(w, s)) {
          /* handled as a bound function call */
        } else if (w->external_invoke_cb != NULL) {
          w->external_invoke_cb(w, s);
        }
      } else if (dispIdMember == WEBVIEW_JS_DOWNLEVEL_ID) {
        /* window.external.downlevel(code): "1" and the ES3 code, or "0"
           and why it could not be translated */
        char err[256];
        char *out = webview_downlevel(s, strlen(s), err, sizeof(err));
        if (pVarResult != NULL) {
          const char *text = (out != NULL) ? out : err;
          size_t n = strlen(text) + 2;
          char *r = (char *)malloc(n);
          WCHAR *wr = NULL;
          if (r != NULL) {
            snprintf(r, n, "%c%s", (out != NULL) ? '1' : '0', text);
            wr = webview_to_utf16(r);
            free(r);
          }
          VariantInit(pVarResult);
          if (wr != NULL) {
            pVarResult->vt = VT_BSTR;
            pVarResult->bstrVal = SysAllocString(wr);
            GlobalFree(wr);
          }
        }
        free(out);
      } else if (dispIdMember == WEBVIEW_JS_LOG_ID) {
        webview_print_log(s);
      } else {
        GlobalFree(s);
        return S_FALSE;
      }
      GlobalFree(s);
    }
  }
  return S_OK;
}

